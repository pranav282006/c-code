#include<stdio.h>
void main(){
    int size;
    printf("Enter array size:\n");
    scanf("%d",&size);
    int arr[size];
    printf("Enter array elemet:\n");
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    int evensum=0;
    int oddsum=0;
    for(int i=0;i<size;i++){
        if(i%2==0){
            evensum=evensum + arr[i];
        }else{
            oddsum=oddsum + arr[i];
        }
    }
    printf("Even sum %d\n",evensum);
    printf("Odd sum %d\n",oddsum);
}
