#include<stdio.h>
void main(){
    int size;
    printf("Enter size array:\n");
    scanf("%d",&size);
    int arr[size];
    printf("enter element in array:\n");
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    int index;
    printf("Enter index:\n");
    scanf("%d",&index);
    if(index>size){
        printf("index is not valid\nRe enter index\n");
        scanf("%d",&index);
    }
    for(int i=0;i<index;i++){
        printf("%d\n",arr[i]);
    }
}
