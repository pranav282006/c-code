#include <stdio.h>

int main() {
    int size1;
    printf("Enter size1:\n");
    scanf("%d", &size1);

    int arr1[size1];
    printf("Enter array1 elements:\n");
    for (int i = 0; i < size1; i++) {
        scanf("%d", &arr1[i]);
    }

    int size2;
    printf("Enter size2:\n");
    scanf("%d", &size2);

    int arr2[size2];
    printf("Enter array2 elements:\n");
    for (int i = 0; i < size2; i++) {
        scanf("%d", &arr2[i]);
    }

    int size3 = size1 + size2;
    int arr3[size3];

    // copy first array
    for (int i = 0; i < size1; i++) {
        arr3[i] = arr1[i];
    }

    // copy second array
    for (int i = 0; i < size2; i++) {
        arr3[size1 + i] = arr2[i];
    }

    printf("Third array:\n");
    for (int i = 0; i < size3; i++) {
        printf("%d ", arr3[i]);
    }

    return 0;
}
