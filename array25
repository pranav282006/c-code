#include<stdio.h>
void main(){
    int size;
    printf("Enter size of array:\n");
    scanf("%d",&size);
    int arr[size];
    printf("Enter elment in array:\n");
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    printf("Array element arre:\n");
    for(int i=0;i<size;i++){
        if(arr[i]%2==0){
            arr[i]=arr[i]*arr[i];
            printf("%d\n",arr[i]);
        }else{
            arr[i]=arr[i]*arr[i]*arr[i];
            printf("%d\n",arr[i]);
        }
    }
}


