#include<stdio.h>
void main(){
    int size;
    printf("Enter size of array:\n");
    scanf("%d",&size);
    int arr[size];
    printf("Enter array elament:\n");
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    int prod=1;
    for(int i=0;i<size;i++){
        if(arr[i]%2==0){
            prod=prod*arr[i];
        }
    }
    printf("product is %d\n",prod);
}
