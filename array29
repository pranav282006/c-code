#include<stdio.h>
void main(){
    int size1;
    printf("Enter size of array:\n");
    scanf("%d",&size1);
    int arr1[size1];
    printf("Enter element in array:\n");
    for(int i=0;i<size1;i++){
        scanf("%d",&arr1[i]);
    }
    int size2;
    printf("Enter size of array:\n");
    scanf("%d",&size2);
    int arr2[size2];
    printf("Enter element in array:\n");
    for(int i=0;i<size2;i++){
        scanf("%d",&arr2[i]);
    }
    int len1=sizeof(arr1)/sizeof(arr1[0]);
    int len2=sizeof(arr2)/sizeof(arr2[0]);
    if(len1==len2){
        printf("Array length are equal:\n");
    }else{
        printf("Array length are not equal:\n");
    }
}
