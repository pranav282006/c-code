#include<stdio.h>
void main(){
    int size1;
    printf("Enter size1:\n");
    scanf("%d",&size1);

    int arr1[size1];
    printf("Enter array element:\n");
    for(int i=0;i<size1;i++){
        scanf("%d",&arr1[i]);
    }

    int size2;
    printf("Enetr size2:\n");
    scanf("%d",&size2);

    int arr2[size2];
    printf("Enter array2:\n");
    for(int i=0;i<size2;i++){
        scanf("%d",&arr2[i]);
    }

    int size3 = size1 + size2;
    int arr3[size3];

    for(int i=0;i<size1;i++){
        arr3[i]=arr1[i];
    }

    for(int i=0;i<size2;i++){
        arr3[size1+i]=arr2[i];
    }

    for(int i=0;i<size3;i++){
        printf("%d\n",arr3[i]);
    }
}
