#include<stdio.h>
void main(){
    int size;
    printf("Enter array size:\n");
    scanf("%d",&size);
    int arr[size];
    for(int i=0;i<size;i++){
        printf("Enter array element:\n");
        scanf("%d",&arr[i]);
    }
    for(int i=0;i<size;i++){
        if(arr[i]%2==0){
            printf("%d is even\n",arr[i]);
        }else{
            printf("%d is odd\n",arr[i]);
        }
    }
}
