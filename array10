#include<stdio.h>
void main(){
    int size;
    printf("Enter size of array:\n");
    scanf("%d",&size);
    int arr[size];
    printf("Enter array elament:\n");
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    int sum=0;
    for(int i=0;i<size;i++){
        if(i%2==0){
            sum=sum+arr[i];
        }
    }
    printf("sumis %d\n",sum);
} 
