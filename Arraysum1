#include<stdio.h>
void main(){
    int size;
    printf("Enter size of array:\n");
    scanf("%d",&size);
    int arr[size];
    printf("Enter element in array:\n");
    for(int i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    int sum=0;
    for(int i=0;i<size;i++){
        sum=sum+arr[i];
    }
    printf("sum is\n");
    printf("%d",sum);
}
