#include<stdio.h>
void main(){
    int size;
    printf("Enter size of array:\n");
    scanf("%d",&size);
    int arr[size];
    for(int i=0;i<size;i++){
        printf("Enter size of element:\n");
        scanf("%d",&arr[i]);
    }
    printf("Array element are:\n");
    for(int i=0;i<size;i++){
        printf("%d\n",arr[i]);
       
    }
}
